<!-- The main start-up ASP.NET Web API project defining API endpoints procecessing business logic -->

<!-- NOTE: This project should contain mainly internal members (except those used by Dependency Injection
     mechanism or Swagger UI - both requiring public members) since it's not a library for other projects -->

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Project -->
    <AssemblyName>OMC.EventsHandler</AssemblyName>
    <VersionPrefix>2.1.0</VersionPrefix>

    <TargetFramework>net10.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Documentation (.xml) -->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>

    <!-- Resources -->
    <NeutralLanguage>en</NeutralLanguage>

    <!-- Docker -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>

    <!-- The dashboard's wwwroot is populated post-build (Docker COPY, or manually for local
         testing), not through MSBuild's static web assets pipeline, and is never committed.
         The build-time manifest that feature generates would otherwise go stale and crash the
         app at startup whenever wwwroot's contents differ from what existed at build time.
         We serve wwwroot ourselves via UseStaticFiles() in Program.cs, so this isn't needed. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!-- Automatically builds the dashboard into wwwroot on first build/F5, so /status "just
       works" without a manual npm step — mirrors the Docker image's Node build stage. Skipped
       once wwwroot exists (so it doesn't slow down every later build), in CI (the Dockerfile
       builds it there instead — no Node tooling on the CI runners), or via
       `-p:SkipDashboardBuild=true`. Never fails the .NET build even if Node/npm isn't
       installed — /status and /status/flow already fall back to /swagger gracefully either way. -->
  <Target Name="BuildDashboardIfMissing" BeforeTargets="Build"
          Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot') AND '$(CI)' != 'true' AND '$(SkipDashboardBuild)' != 'true'">
    <Message Importance="high"
             Text="Dashboard not built yet — installing dependencies and running 'npm run build:omc' so /status works (first build only; pass -p:SkipDashboardBuild=true to skip)." />
    <!-- Unconditional, not just "if node_modules is missing": a colleague's checkout can also
         have an older node_modules that predates a newly added dependency (e.g. @xyflow/react),
         which still fails 'next build' with the same "Module not found" error. npm install is
         a fast no-op when nothing changed, so there's no real cost to always running it here. -->
    <Exec Command="npm install"
          WorkingDirectory="$(MSBuildProjectDirectory)/../../../../dashboard"
          ContinueOnError="WarnAndContinue" />
    <Exec Command="npm run build:omc"
          WorkingDirectory="$(MSBuildProjectDirectory)/../../../../dashboard"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <!-- Packages -->
  <ItemGroup>
    <!-- API -->
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.12.19">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="E4A.PostGuard" Version="0.3.0" />
    <!-- Logging -->
    <PackageReference Include="Sentry.AspNetCore" Version="4.13.0" />
    <PackageReference Include="Sentry.Profiling" Version="4.13.0" />
    <!-- UI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="8.0.2" />
  </ItemGroup>

  <!-- Projects -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Infrastructure\Persistence\WebQueries\WebQueries.csproj" />
  </ItemGroup>

  <!-- Exposition to internal members -->
  <ItemGroup>
    <InternalsVisibleTo Include="OMC.EventsHandler.Tests.Integration" />
    <InternalsVisibleTo Include="OMC.EventsHandler.Tests.Unit" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- Resources (text / localization) -->
  <ItemGroup>
    <Compile Update="Properties\ApiResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ApiResources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\ApiResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ApiResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="Services\Configuration\Data\ScenarioFlows.json" />
  </ItemGroup>

</Project>