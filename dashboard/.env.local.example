# Base URL of the OMC .NET API this dashboard talks to.
# Only needed for local dev, where this app runs on its own port (3000) separate
# from the API (5270). In production this is left unset: the app is statically
# exported and served by OMC itself, so requests are same-origin and relative.
NEXT_PUBLIC_OMC_API_URL=http://localhost:5270
